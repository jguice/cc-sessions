    return {}


def save_session_names(names: dict):
    os.makedirs(os.path.dirname(NAMES_FILE), exist_ok=True)
    with open(NAMES_FILE, "w") as f:
        json.dump(names, f, indent=2)


_TAG_RE = re.compile(r"<[^>]+>")
_CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")


def clean_label(text: str, max_len: int = LABEL_MAX) -> str:
    """Sanitize a string destined for a row label or preview heading."""
    if not text:
        return ""
    text = _TAG_RE.sub("", text)
    text = _CTRL_RE.sub(" ", text)
    text = " ".join(text.split())
    if len(text) >= 2 and text[0] == '"' and text[-1] == '"':
        text = text[1:-1].strip()
    return text[:max_len]


def clean_body(text: str, max_len: int = BODY_MAX) -> str:
    """Sanitize multi-line prose for the preview: keep newlines, neutralize markup."""
    if not text:
        return ""
    text = _CTRL_RE.sub(" ", text)
    # Demote injected headings so model/user text can't open a peer section
    text = re.sub(r"(?m)^(#{1,6})\s*(.+)$", r"**\2**", text)
    text = text[:max_len].rstrip()
    # Balance code fences: an unclosed fence would swallow every section below
    if text.count("```") % 2:
        text += "\n```"
    return text


def load_summaries() -> dict:
    if os.path.exists(SUMMARIES_FILE):
        try:
            with open(SUMMARIES_FILE) as f:
                return json.load(f)
        except Exception:
            pass
    return {}


def save_summary(session_id: str, entry: dict):
    """Merge one entry into summaries.json without clobbering another instance's writes."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    current = load_summaries()
    current[session_id] = entry
    tmp = SUMMARIES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(current, f, indent=2)
    os.replace(tmp, SUMMARIES_FILE)


def drop_summary(session_id: str):
    current = load_summaries()
    if current.pop(session_id, None) is None:
        return
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = SUMMARIES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(current, f, indent=2)
    os.replace(tmp, SUMMARIES_FILE)


def resolve_label(session: dict, names: dict, summaries: dict) -> str:
    """Seven-level precedence for a session's display label."""
    sid = session["session_id"]
    local = names.get(sid, "")
    if local:
        return local
    if session.get("custom_title"):
        return session["custom_title"]
    entry = summaries.get(sid) or {}
    if entry.get("title"):
        # A saved summary wins only while the ai-title it overrode is unchanged.
        # If Claude wrote a genuinely new title since, that new title supersedes it.
        if clean_label(entry.get("ai_title_at_generation") or "") == (session.get("ai_title") or ""):
            return entry["title"]
    if session.get("ai_title"):
        return session["ai_title"]
    if session.get("last_prompt"):
        return session["last_prompt"]
    if session.get("last_msg"):
        return session["last_msg"]
    return sid[:12]


def _extract_user_text(d):
    """Extract typed user text from a parsed JSONL entry. Returns (oneline, raw) or None.

    Skips isMeta records (hook injections) and tool_result carriers: every consumer wants
    "a message the user actually typed". This changes last_msg on ~16% of sessions.
    """
    if d.get("type") != "user" or d.get("isMeta"):
        return None
    content = d.get("message", {}).get("content", "")
    if isinstance(content, list):
        # A block list containing a tool_result is a tool response, not a typed message
        for c in content:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                return None
        for c in content:
            if isinstance(c, dict) and c.get("type") == "text":
                text = c["text"].strip()
                text = re.sub(r"<[^>]+>", "", text).strip()
                if text:
                    return text.replace("\n", " "), text
    elif isinstance(content, str):
        text = re.sub(r"<[^>]+>", "", content).strip()
        if text:
            return text.replace("\n", " "), text
    return None


def _rel_path(path: str, cwd: str) -> str:
    """trackingPath is cwd-relative when under cwd; tool_use file_path is absolute."""
    if not path:
        return ""
    if not os.path.isabs(path) and cwd:
        path = os.path.join(cwd, path)
    return os.path.normpath(path)


def _parse_tail(jsonl_path: str, cwd: str) -> dict:
    """Parse the 128KB tail window for title, prompt, reply and edited-file records."""
    out = {
        "ai_title": "", "custom_title": "", "last_prompt": "",
        "last_assistant": "", "files_edited": [], "last_msg": "",
    }
    files = []
    asst_idx = user_idx = -1
    asst_text = ""
    for i, line in enumerate(_read_tail_lines(jsonl_path)):
        try:
            d = json.loads(line)
        except Exception:
            continue  # includes the torn first line; expected, not an error
        t = d.get("type")
        if t == "ai-title":
            if d.get("aiTitle"):
                out["ai_title"] = clean_label(d["aiTitle"])
        elif t == "custom-title":
            if d.get("customTitle"):
                out["custom_title"] = clean_label(d["customTitle"])
        elif t == "last-prompt":
            # 0.8% of these records carry no lastPrompt field
            if d.get("lastPrompt"):
                out["last_prompt"] = d["lastPrompt"]
        elif t == "file-history-delta":
            p = _rel_path(d.get("trackingPath", ""), cwd)
            if p:
                files.append(p)
        elif t == "assistant":
            msg = d.get("message", {}) or {}
            if msg.get("model") != "<synthetic>":
                for b in msg.get("content", []) or []:
                    if isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip():
                        asst_idx, asst_text = i, b["text"].strip()
            for b in msg.get("content", []) or []:
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in (
                    "Edit", "Write", "NotebookEdit"
                ):
                    inp = b.get("input") or {}
                    p = _rel_path(inp.get("file_path") or inp.get("notebook_path") or "", cwd)
                    if p:
                        files.append(p)
        if t == "user":
            result = _extract_user_text(d)
            if result:
                user_idx = i
                out["last_msg"] = result[0]
    # Only pair the reply with the prompt when it actually followed it
    if asst_idx > user_idx:
        out["last_assistant"] = asst_text
    seen = set()
    out["files_edited"] = [p for p in files if not (p in seen or seen.add(p))]
    return out


def load_sessions():
    """Scan all session files and return a list of session dicts."""
    sessions = []
    for jsonl_path in glob.glob(os.path.join(PROJECTS_BASE, "*", "*.jsonl")):
        if "/subagents/" in jsonl_path:
            continue
        mtime = os.path.getmtime(jsonl_path)
        session_id = os.path.basename(jsonl_path).replace(".jsonl", "")
        fsize = os.path.getsize(jsonl_path)
        cwd = ""
        first_msg = ""
        first_msg_raw = ""
        try:
            # Read head for cwd and first message
            with open(jsonl_path) as f:
                for i, line in enumerate(f):
                    if i > 50:
                        break
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if not cwd and d.get("cwd"):
                        cwd = d["cwd"]
                    if not first_msg:
                        result = _extract_user_text(d)
                        if result:
                            first_msg, first_msg_raw = result
                    if cwd and first_msg:
                        break

            # Single tail read yields titles, prompt, reply, edited files and last_msg
            meta = _parse_tail(jsonl_path, cwd)
            last_msg = meta["last_msg"]
        except Exception:
            continue
        if cwd:
            if not last_msg:
                last_msg = first_msg
            cwd_short = cwd.replace(HOME, "~")
            ai_title = meta["ai_title"]
            custom_title = meta["custom_title"]
            last_prompt = clean_label(meta["last_prompt"], BODY_MAX)
            sessions.append({
                "mtime": mtime,
                "session_id": session_id,
                "cwd": cwd,
                "cwd_short": cwd_short,
                "cwd_condensed": condense_path(cwd),
                "first_msg": first_msg,
                "first_msg_raw": first_msg_raw,
                "last_msg": last_msg,
                "ai_title": ai_title,
                "custom_title": custom_title,
                "last_prompt": last_prompt,
                "last_assistant": meta["last_assistant"],
                "files_edited": meta["files_edited"],
                "path": jsonl_path,
                "size": fsize,
                "age": time.time() - mtime,
                # Pre-lowered for fast search filtering. Local names and summaries are
                # matched live instead, since both mutate at runtime.
                "_search": " ".join((
                    first_msg, last_msg, cwd_short, session_id,
                    ai_title, custom_title, last_prompt,
                )).lower(),
            })
    return sessions


def _read_tail_lines(filepath):
    """Read the tail window of a file as lines.

    The whole window is returned: the records we need sit up to 28 lines from EOF. The
    first line is partial for files larger than the window (the seek lands mid-line);
    callers discard it via their own json parse failure.
    """
    try:
        with open(filepath, "rb") as f:
            f.seek(0, 2)
            fsize = f.tell()
            if fsize == 0:
                return []
            chunk_size = min(fsize, TAIL_WINDOW)
            f.seek(fsize - chunk_size)
            return f.read().decode("utf-8", errors="replace").splitlines()
    except Exception:
        return []


def group_sessions(sessions, sort_mode="recency"):
    """Group sessions by directory and sort."""
    from collections import defaultdict
    groups = defaultdict(list)
    for s in sessions:
        groups[s["cwd"]].append(s)

    for items in groups.values():
        # Sessions within a group always sort by recency first,
        # then by the selected secondary sort
        if sort_mode == "size":
            items.sort(key=lambda x: -x["size"])
        else:
            items.sort(key=lambda x: -x["mtime"])

    sorted_groups = []
    for cwd, items in groups.items():
        sorted_groups.append((items[0]["mtime"], cwd, items))

    # Sort groups: by name sorts directories alphabetically, others by most recent session
    if sort_mode == "name":
        sorted_groups.sort(key=lambda x: condense_path(x[1]).lower())
    else:
        sorted_groups.sort(key=lambda x: -x[0])
    return sorted_groups


def render_table(table_text: str) -> str:
    """Convert a markdown table to aligned plain text with box-drawing chars."""
    lines = [l.strip() for l in table_text.strip().split("\n") if l.strip()]
    if len(lines) < 2:
        return table_text
    rows = []
    for i, l in enumerate(lines):
        if i == 1:
            continue
        cells = [c.strip() for c in l.split("|")[1:-1]]
        rows.append(cells)
    if not rows:
        return table_text
    ncols = max(len(r) for r in rows)
    widths = [0] * ncols
    for r in rows:
        for j, c in enumerate(r):
            if j < ncols:
                widths[j] = max(widths[j], len(c))
    out = []
    sep = "\u2500" + "\u2500\u253c\u2500".join("\u2500" * (w + 1) for w in widths) + "\u2500"
    for i, r in enumerate(rows):
        padded = []
        for j in range(ncols):
            val = r[j] if j < len(r) else ""
            padded.append(val.ljust(widths[j]))
        out.append(" " + " \u2502 ".join(padded))
        if i == 0:
            out.append(sep)
    return "\n".join(out)


def prepare_markdown(msg: str) -> str:
    """Pre-process markdown: convert tables to code blocks for proper rendering."""
    table_pattern = re.compile(r"(\n?\|[^\n]+\|\n\|[\s:|-]+\|\n(?:\|[^\n]+\|\n?)+)")
    return table_pattern.sub(
        lambda m: "\n```\n" + render_table(m.group(0)) + "\n```\n", msg
    )


SUMMARY_PROMPT = (
    "You summarize Claude Code session transcripts. Output ONLY minified JSON: "
    '{"title":"...","body":"..."}. No markdown fences, no preamble. '
    "title: under 60 characters, describing what the session was about. "
    "body: 2-3 sentences on what was accomplished and where the work stopped."
)

_SUMMARY_HEAD = 256 * 1024
_SUMMARY_TAIL = 512 * 1024
_SUMMARY_MAX_CHARS = 60 * 1024


def _summary_input(session: dict) -> str:
    """User prompts and assistant text only, from a bounded head read and tail seek.

    The middle of the file is never read: sessions reach 205MB and are mostly tool output.
    """
    path = session["path"]
    chunks = []
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            head = f.read(_SUMMARY_HEAD)
            if size > _SUMMARY_HEAD + _SUMMARY_TAIL:
                f.seek(size - _SUMMARY_TAIL)
                tail = f.read(_SUMMARY_TAIL)
            else:
                tail = b""
    except Exception:
        return ""
    for blob, is_tail in ((head, False), (tail, True)):
        lines = blob.decode("utf-8", errors="replace").splitlines()
        # The seek/read boundary lands mid-line: drop the partial end of each chunk
        if is_tail:
            lines = lines[1:]
        elif len(blob) == _SUMMARY_HEAD and lines:
            lines = lines[:-1]
        for line in lines:
            try:
                d = json.loads(line)
            except Exception:
                continue
            result = _extract_user_text(d)
            if result:
                chunks.append("USER: " + result[1][:1500])
                continue
            if d.get("type") == "assistant":
                msg = d.get("message", {}) or {}
                if msg.get("model") == "<synthetic>":
                    continue
                for b in msg.get("content", []) or []:
                    if isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip():
                        chunks.append("ASSISTANT: " + b["text"].strip()[:1500])
        if not is_tail and tail:
            chunks.append("... (middle of session omitted) ...")
    text = "\n\n".join(chunks)
    return text[:_SUMMARY_MAX_CHARS]


def generate_summary(session: dict):
    """Run Claude Code headless with Haiku. Returns {"title","body"} or None."""
    transcript = _summary_input(session)
    if not transcript.strip():
        return None
    cmd = [
        "claude", "-p", "--model", "haiku",
        # --safe-mode is load-bearing: without it CLAUDE.md, hooks, MCP and plugins load,
        # which triples latency and leaks the user's custom instructions into the output.
        "--safe-mode", "--tools", "", "--no-session-persistence",
        "--system-prompt", SUMMARY_PROMPT,
        "Summarize this session transcript:\n\n" + transcript,
    ]
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=SUMMARY_TIMEOUT
        )
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    raw = (proc.stdout or "").strip()
    if raw.startswith("```"):
        raw = re.sub(r"^```[a-z]*\n?|\n?```$", "", raw).strip()
    try:
        data = json.loads(raw)
    except Exception:
        return None
    title = clean_label(str(data.get("title", "")))
    body = clean_body(str(data.get("body", "")))
    if not title:
        return None
    return {"title": title, "body": body}


