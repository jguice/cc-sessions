    def __init__(self):
        super().__init__()
        prefs = self._load_prefs()
        self.theme = prefs.get("theme", "gruvbox")
        self.sessions = []
        self.session_names = {}
        self.summaries = load_summaries()
        self._summarizing = set()
        self.sort_mode = "recency"
        self.selected_ids: Set[str] = set()
        self.filter_text = ""
        self._resume_session = None  # set when user picks a session to resume
        self._loading = True

    TITLE = f"{ICON_CLAUDE} cc-sessions"

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False, icon="")
        with Vertical(id="search-bar"):
            yield Input(placeholder=f"{ICON_SEARCH} Search sessions...", id="search-input")
        with Horizontal(id="main"):
            yield Tree("Sessions", id="session-tree")
            yield Vertical(
                Markdown("", id="preview"),
                id="preview-pane",
            )
        yield Static("", id="status-bar")
        yield Footer()

    def on_mount(self):
        tree = self.query_one("#session-tree", Tree)
        tree.show_root = False
        tree.guide_depth = 3
        tree.root.add_leaf("Loading sessions...")
        self._load_sessions_async()

    @work(thread=True)
    def _load_sessions_async(self):
        sessions = load_sessions()
        names = load_session_names()
        summaries = load_summaries()
        self.call_from_thread(self._finish_loading, sessions, names, summaries)

    def _finish_loading(self, sessions, names, summaries):
        self.sessions = sessions
        self.session_names = names
        self.summaries = summaries
        self._loading = False
        self._rebuild_tree()
        self._update_status()
        sort_label = "folder name" if self.sort_mode == "name" else self.sort_mode
        self.sub_title = f"sorted by {sort_label}"
        self.query_one("#session-tree", Tree).focus()

    def watch_theme(self, new_theme: str) -> None:
        """Rebuild tree when theme changes so colors update, and save preference."""
        try:
            self.query_one("#session-tree", Tree)
            self._rebuild_tree()
        except Exception:
            pass  # tree not mounted yet
        self._save_prefs()

    @staticmethod
    def _load_prefs() -> dict:
        if os.path.exists(PREFS_FILE):
            try:
                with open(PREFS_FILE) as f:
                    return json.load(f)
            except Exception:
                pass
        return {}

    def _save_prefs(self):
        prefs = self._load_prefs()
        prefs["theme"] = self.theme
        os.makedirs(os.path.dirname(PREFS_FILE), exist_ok=True)
        with open(PREFS_FILE, "w") as f:
            json.dump(prefs, f, indent=2)

    # -- Tree building --

    def _rebuild_tree(self):
        """Filter, group, and rebuild the tree. Shows a loading indicator for searches."""
        if self.filter_text and self.sessions:
            tree = self.query_one("#session-tree", Tree)
            tree.clear()
            tree.root.add_leaf("Searching...")
            self._rebuild_tree_async()
        else:
            self._do_rebuild_tree()

    @work(thread=True)
    def _rebuild_tree_async(self):
        """Pre-compute filtered groups in a thread, then assemble tree on main thread."""
        prepared = self._prepare_tree_data()
        self.call_from_thread(self._assemble_tree, prepared)

    def _prepare_tree_data(self):
        """Filter and group sessions, return lightweight data for tree assembly."""
        filtered = self.sessions
        if self.filter_text:
            ft = self.filter_text.lower()
            filtered = [
                s for s in self.sessions
                if ft in s["_search"]
                or ft in self.session_names.get(s["session_id"], "").lower()
                or ft in self._summary_text(s["session_id"])
            ]
        groups = group_sessions(filtered, self.sort_mode)
        # Pre-compute label parts as plain data
        prepared = []
        for _, cwd, items in groups:
            item_data = []
            for s in items:
                item_data.append({
                    "session": s,
                    "age": human_age(s["age"]),
                    "size": human_size(s["size"]),
                    "label": resolve_label(s, self.session_names, self.summaries),
                    "selected": s["session_id"] in self.selected_ids,
                })
            prepared.append((cwd, item_data))
        return prepared

    def _assemble_tree(self, prepared):
        """Build tree nodes from pre-computed data (runs on main thread)."""
        tree = self.query_one("#session-tree", Tree)
        tree.clear()

        theme = self.current_theme
        accent = theme.accent if theme else "#fabd2f"
        primary = theme.primary if theme else "#85A598"
        secondary = theme.secondary if theme else "#A89A85"
        success = theme.success if theme else "#b8bb26"

        for cwd, items in prepared:
            cwd_condensed = condense_path(cwd)
            dir_text = Text()
            dir_text.append(f"{ICON_FOLDER} ", style=f"bold {accent}")
            dir_text.append(f"{cwd_condensed} ", style=f"bold {primary}")
            dir_text.append(f"({len(items)})", style="dim")
            dir_node = tree.root.add(dir_text, expand=False)
            dir_node.data = None
            dir_node._cwd_key = cwd

            for item in items:
                s = item["session"]
                label = Text()
                if item["selected"]:
                    label.append(f"{ICON_CHECK} ", style=f"bold {success}")
                label.append(f"{ICON_CLOCK} {item['age']:>7} ", style=f"{accent}")
                label.append(f"{ICON_SIZE} {item['size']:>7}", style="dim")
                label.append("  ", style="")
                label.append(item["label"], style=f"{secondary}")
                tail = s.get("last_prompt", "")
                if tail and tail != item["label"]:
                    label.append(f"  · {clean_label(tail)}", style="dim")

                leaf = dir_node.add_leaf(label)
                leaf.data = s

        pending = getattr(self, "_pending_view_state", None)
        if pending is not None:
            self._pending_view_state = None
            expanded_cwds, target_session_id = pending
            for dir_node in tree.root.children:
                if getattr(dir_node, "_cwd_key", None) in expanded_cwds:
                    dir_node.expand()
            if target_session_id:
                for dir_node in tree.root.children:
                    if not dir_node.is_expanded:
                        continue
                    for leaf in dir_node.children:
                        if leaf.data and leaf.data["session_id"] == target_session_id:
                            self.call_after_refresh(self._select_leaf_after_refresh, leaf)
                            return

    def _select_leaf_after_refresh(self, leaf):
        tree = self.query_one("#session-tree", Tree)
        self._suppress_selection_exit = True
        tree.select_node(leaf)
        if leaf.data:
            self._update_preview(leaf.data)

    def _do_rebuild_tree(self):
        """Synchronous rebuild for non-search cases (no filter, fast path)."""
        prepared = self._prepare_tree_data()
        self._assemble_tree(prepared)

    def _update_status(self):
        total = len(self.sessions)
        selected = len(self.selected_ids)
        sort_label = self.sort_mode.capitalize()
        parts = [f"{ICON_SESSION} {total} sessions", f"{ICON_SORT} {sort_label}"]
        if selected:
            parts.append(f"{selected} selected")
        if self.filter_text:
            parts.append(f"Filter: {self.filter_text}")
        self.query_one("#status-bar", Static).update(" | ".join(parts))

    def _update_preview(self, session: Optional[dict]):
        preview = self.query_one("#preview", Markdown)
        if session is None:
            preview.update("")
            return

        sid = session["session_id"]
        label = resolve_label(session, self.session_names, self.summaries)
        meta_bits = [f"`{session['cwd_short']}`", human_size(session["size"])]
        parts = ["## " + label, " · ".join(meta_bits)]

        entry = self.summaries.get(sid) or {}
        if entry.get("body"):
            when = time.strftime("%Y-%m-%d", time.localtime(entry.get("generated_at", 0)))
            head = f"*Generated {when}"
            if entry.get("title"):
                head += f' · "{entry["title"]}"'
            if entry.get("session_mtime", 0) < session["mtime"]:
                head += " · session has changed since"
            parts += ["### Summary", head + "*", entry["body"]]

        if session.get("first_msg_raw"):
            parts += ["### Started with",
                      prepare_markdown(clean_body(session["first_msg_raw"]))]

        if session.get("last_prompt") or session.get("last_assistant"):
            parts.append("### Where I left off")
            if session.get("last_prompt"):
                quoted = "\n".join("> " + l for l in session["last_prompt"].split("\n"))
                parts.append(quoted)
            if session.get("last_assistant"):
                parts.append(prepare_markdown(clean_body(session["last_assistant"])))

        files = session.get("files_edited") or []
        if files:
            parts.append(f"### Recently edited ({len(files)})")
            shown = files[:10]
            for p in shown:
                rel = os.path.relpath(p, session["cwd"]) if p.startswith(session["cwd"]) else p
                parts.append(f"- `{rel}`")
            if len(files) > len(shown):
                parts.append(f"- *+{len(files) - len(shown)} more*")

        parts.append(f"---\n\n*`{sid}`*")
        preview.update("\n\n".join(parts))

    # -- Event handlers --

    def on_tree_node_selected(self, event: Tree.NodeSelected):
        """When Enter is pressed on a tree node."""
        if getattr(self, "_suppress_selection_exit", False):
            self._suppress_selection_exit = False
            return
        node = event.node
        if node.data is None:
            # Directory node: toggle expand/collapse
            node.toggle()
        else:
            # Session node: resume it
            self._resume_session = node.data
            self.exit()

    def on_tree_node_highlighted(self, event: Tree.NodeHighlighted):
        """Update preview when cursor moves."""
        node = event.node
        if node.data is not None:
            self._update_preview(node.data)
        else:
            self._update_preview(None)

    # -- Vi navigation --

    def action_scroll_home(self):
        tree = self.query_one("#session-tree", Tree)
        tree.action_scroll_home()

    def action_scroll_end(self):
        tree = self.query_one("#session-tree", Tree)
        tree.action_scroll_end()

    def action_page_up(self):
        tree = self.query_one("#session-tree", Tree)
        tree.scroll_page_up()

    def action_page_down(self):
        tree = self.query_one("#session-tree", Tree)
        tree.scroll_page_down()

    def on_key(self, event):
        """Handle vi keys and left/right arrows for tree navigation."""
        # Down arrow from search input jumps to the tree
        focused = self.focused
        if focused and getattr(focused, "id", None) == "search-input":
            if event.key == "down":
                self.query_one("#session-tree", Tree).focus()
                event.prevent_default()
            return

        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node is None:
            return

        # h/l map to left/right (expand/collapse), j/k map to down/up
        if event.key in ("left", "h"):
            if node.data is None and node.is_expanded:
                node.collapse()
                event.prevent_default()
            elif node.data is not None:
                if node.parent and node.parent != tree.root:
                    tree.select_node(node.parent)
                    node.parent.collapse()
                    event.prevent_default()
            elif node.data is None and not node.is_expanded:
                # Already collapsed dir: move to parent
                if node.parent and node.parent != tree.root:
                    tree.select_node(node.parent)
                    event.prevent_default()
        elif event.key in ("right", "l"):
            if node.data is None and not node.is_expanded:
                node.expand()
                event.prevent_default()
            elif node.data is None and node.is_expanded:
                # Already expanded: move to first child
                if node.children:
                    tree.select_node(node.children[0])
                    event.prevent_default()
        elif event.key == "j":
            tree.action_cursor_down()
            event.prevent_default()
        elif event.key == "k":
            tree.action_cursor_up()
            event.prevent_default()
        elif event.key == "escape":
            search_bar = self.query_one("#search-bar")
            if search_bar.styles.display != "none":
                self._close_search()
                event.prevent_default()

    # -- Actions --

    def action_search(self):
        search_bar = self.query_one("#search-bar")
        search_input = self.query_one("#search-input", Input)
        if search_bar.styles.display == "none":
            search_bar.styles.display = "block"
            search_input.value = self.filter_text
            search_input.focus()
        else:
            self._close_search()

    def _close_search(self):
        self.query_one("#search-bar").styles.display = "none"
        self.query_one("#session-tree", Tree).focus()

    def on_input_changed(self, event: Input.Changed):
        if event.input.id == "search-input":
            self.filter_text = event.value
            if hasattr(self, "_search_timer") and self._search_timer is not None:
                self._search_timer.stop()
            self.query_one("#status-bar", Static).update("Searching...")
            self._search_timer = self.set_timer(0.1, self._finish_search)

    def _finish_search(self):
        self._search_timer = None
        self._rebuild_tree()
        self._update_status()

    def on_input_submitted(self, event: Input.Submitted):
        if event.input.id == "search-input":
            self.query_one("#search-bar").styles.display = "none"
            self.query_one("#session-tree", Tree).focus()


    def action_expand_all(self):
        tree = self.query_one("#session-tree", Tree)
        for node in tree.root.children:
            node.expand()

    def action_collapse_all(self):
        tree = self.query_one("#session-tree", Tree)
        for node in tree.root.children:
            node.collapse()

    def run_palette_command(self, command: str):
        """Execute a command from the command palette."""
        actions = {
            "expand_all": self.action_expand_all,
            "collapse_all": self.action_collapse_all,
            "sort_name": lambda: self._set_sort("name"),
            "sort_recency": lambda: self._set_sort("recency"),
            "sort_size": lambda: self._set_sort("size"),
            "search": self.action_search,
            "clear_search": self._clear_search,
            "archive": self.action_archive,
            "delete": self.action_delete,
            "rename": self.action_rename,
            "summarize": self.action_summarize,
            "toggle_skip_perms": self._toggle_skip_perms,
        }
        if command in actions:
            actions[command]()

    def _set_sort(self, mode: str):
        self.sort_mode = mode
        self._rebuild_tree()
        self._update_status()
        sort_label = "folder name" if self.sort_mode == "name" else self.sort_mode
        self.sub_title = f"sorted by {sort_label}"

    def _toggle_skip_perms(self):
        prefs = self._load_prefs()
        current = prefs.get("dangerously_skip_permissions", False)
        prefs["dangerously_skip_permissions"] = not current
        os.makedirs(os.path.dirname(PREFS_FILE), exist_ok=True)
        with open(PREFS_FILE, "w") as f:
            json.dump(prefs, f, indent=2)
        state = "ON" if not current else "OFF"
        self._update_status()
        self.notify(f"Skip permissions: {state}")

    def _clear_search(self):
        self.filter_text = ""
        self._rebuild_tree()
        self._update_status()

    def action_cycle_sort(self):
        idx = SORT_MODES.index(self.sort_mode)
        self.sort_mode = SORT_MODES[(idx + 1) % len(SORT_MODES)]
        self._rebuild_tree()
        self._update_status()
        sort_label = "folder name" if self.sort_mode == "name" else self.sort_mode
        self.sub_title = f"sorted by {sort_label}"

    def action_toggle_select(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node and node.data:
            sid = node.data["session_id"]
            if sid in self.selected_ids:
                self.selected_ids.discard(sid)
            else:
                self.selected_ids.add(sid)
            self._rebuild_tree()
            self._update_status()

    def action_delete(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node and node.data:
            s = node.data
            name = resolve_label(s, self.session_names, self.summaries)
            self.push_screen(
                ConfirmDialog(f"Delete session '{name}' permanently?"),
                callback=lambda ok: self._do_delete([s]) if ok else None,
            )

    def action_archive(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node and node.data:
            s = node.data
            name = resolve_label(s, self.session_names, self.summaries)
            self.push_screen(
                ConfirmDialog(f"Archive session '{name}'?"),
                callback=lambda ok: self._do_archive([s]) if ok else None,
            )

    def action_delete_selected(self):
        if not self.selected_ids:
            return
        targets = [s for s in self.sessions if s["session_id"] in self.selected_ids]
        self.push_screen(
            ConfirmDialog(f"Delete {len(targets)} sessions permanently?"),
            callback=lambda ok: self._do_delete(targets) if ok else None,
        )

    def action_archive_selected(self):
        if not self.selected_ids:
            return
        targets = [s for s in self.sessions if s["session_id"] in self.selected_ids]
        self.push_screen(
            ConfirmDialog(f"Archive {len(targets)} sessions?"),
            callback=lambda ok: self._do_archive(targets) if ok else None,
        )

    def action_rename(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node and node.data:
            sid = node.data["session_id"]
            current = self.session_names.get(sid, "")
            self.push_screen(
                RenameDialog(current),
                callback=lambda name: self._do_rename(sid, name),
            )

    def _summary_text(self, session_id: str) -> str:
        entry = self.summaries.get(session_id) or {}
        return (entry.get("title", "") + " " + entry.get("body", "")).lower()

    def action_summarize(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if not node or not node.data:
            return
        s = node.data
        sid = s["session_id"]
        if sid in self._summarizing:
            self.notify("Already summarizing this session")
            return
        self._summarizing.add(sid)
        self.query_one("#status-bar", Static).update(f"Summarizing {sid[:8]}...")
        self._summarize_async(s)

    @work(thread=True)
    def _summarize_async(self, session: dict):
        result = generate_summary(session)
        self.call_from_thread(self._finish_summary, session, result)

    def _finish_summary(self, session: dict, result):
        sid = session["session_id"]
        self._summarizing.discard(sid)
        if not result:
            self._update_status()
            self.notify("Summary failed; previous summary kept", severity="warning")
            return
        entry = {
            "title": result["title"],
            "body": result["body"],
            "generated_at": int(time.time()),
            "session_mtime": session["mtime"],
            "ai_title_at_generation": session.get("ai_title", ""),
        }
        try:
            save_summary(sid, entry)
        except Exception:
            self._update_status()
            self.notify("Could not write summaries.json", severity="error")
            return
        self.summaries[sid] = entry
        session["_search"] = (session["_search"] + " " + entry["title"] + " " + entry["body"]).lower()
        self._update_status()
        self.notify(f'Summary: {entry["title"]}')
        # Preserve folder expansion and cursor across the rebuild the new label triggers
        self._pending_view_state = (self._snapshot_expanded_cwds(), sid)
        self._rebuild_tree()

    def _do_delete(self, targets: List[dict]):
        for s in targets:
            try:
                os.remove(s["path"])
                # Remove subagents dir too
                subdir = os.path.join(os.path.dirname(s["path"]), "subagents")
                if os.path.isdir(subdir):
                    shutil.rmtree(subdir, ignore_errors=True)
            except Exception:
                pass
            drop_summary(s["session_id"])
            self.summaries.pop(s["session_id"], None)
            if self.session_names.pop(s["session_id"], None) is not None:
                save_session_names(self.session_names)
            self.selected_ids.discard(s["session_id"])
        self.sessions = [s for s in self.sessions if s not in targets]
        self._rebuild_tree()
        self._update_status()
        self._update_preview(None)

    def _snapshot_expanded_cwds(self) -> set:
        tree = self.query_one("#session-tree", Tree)
        return {
            getattr(n, "_cwd_key", None)
            for n in tree.root.children
            if n.is_expanded and getattr(n, "_cwd_key", None) is not None
        }

    def _next_session_after_removal(self, target_ids: set) -> Optional[str]:
        """Pick the session_id to select after removing target_ids.

        Stays within the cursor's folder: prefer the session below, fall back
        to the one above. Returns None if the cursor isn't on a session or
        the folder has no surviving sessions."""
        tree = self.query_one("#session-tree", Tree)
        cursor = tree.cursor_node
        if not cursor or not cursor.data:
            return None
        cursor_id = cursor.data["session_id"]
        cursor_cwd = cursor.data["cwd"]

        same_folder = [s for s in self.sessions if s["cwd"] == cursor_cwd]
        if self.sort_mode == "size":
            same_folder.sort(key=lambda x: -x["size"])
        else:
            same_folder.sort(key=lambda x: -x["mtime"])
        ordered = [s["session_id"] for s in same_folder]

        if cursor_id in ordered and cursor_id not in target_ids:
            return cursor_id
        if cursor_id not in ordered:
            return None
        start_idx = ordered.index(cursor_id)
        for i in range(start_idx + 1, len(ordered)):
            if ordered[i] not in target_ids:
                return ordered[i]
        for i in range(start_idx - 1, -1, -1):
            if ordered[i] not in target_ids:
                return ordered[i]
        return None

    def _do_archive(self, targets: List[dict]):
        os.makedirs(ARCHIVE_DIR, exist_ok=True)

        target_ids = {s["session_id"] for s in targets}
        self._pending_view_state = (
            self._snapshot_expanded_cwds(),
            self._next_session_after_removal(target_ids),
        )

        for s in targets:
            try:
                dest = os.path.join(ARCHIVE_DIR, os.path.basename(s["path"]))
                shutil.move(s["path"], dest)
                subdir = os.path.join(os.path.dirname(s["path"]), "subagents")
                if os.path.isdir(subdir):
                    shutil.move(subdir, os.path.join(ARCHIVE_DIR, s["session_id"] + "-subagents"))
            except Exception:
                pass
            self.selected_ids.discard(s["session_id"])
        self.sessions = [s for s in self.sessions if s not in targets]
        self._update_preview(None)
        self._rebuild_tree()
        self._update_status()

    def _do_rename(self, session_id: str, name: str):
        if not name:
            self.session_names.pop(session_id, None)
        else:
            self.session_names[session_id] = name
        save_session_names(self.session_names)
        self._rebuild_tree()
        self._update_preview_for_current()

    def _update_preview_for_current(self):
        tree = self.query_one("#session-tree", Tree)
        node = tree.cursor_node
        if node and node.data:
            self._update_preview(node.data)


def main():
    app = SessionBrowser()
    app.run()

    # After the app exits, if a session was selected, print the resume command
    if app._resume_session:
        s = app._resume_session
        prefs = SessionBrowser._load_prefs()
        skip_perms = "1" if prefs.get("dangerously_skip_permissions", False) else "0"
        print(f"RESUME\t{s['cwd']}\t{s['session_id']}\t{skip_perms}")


if __name__ == "__main__":
    main()
